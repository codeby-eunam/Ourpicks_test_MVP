# Supabase 프로젝트 설정 > API 메뉴에서 값을 복사하세요.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Default: false. The bundled restaurant catalog avoids one Supabase read per
# visit. Enable only if restaurant data must be loaded live from Supabase.
NEXT_PUBLIC_USE_REMOTE_RESTAURANTS=false

# --- 아래 두 개는 scripts/seed-restaurants.mjs 실행에만 필요 (로컬/CI 전용, 절대 클라이언트에 노출 금지) ---
# Supabase 프로젝트 설정 > API > service_role 키 (RLS 우회 권한 - 서버 전용)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Google Cloud Console > API 및 서비스 > 사용자 인증 정보에서 발급한 Places API 키
GOOGLE_PLACES_API_KEY=your-google-places-api-key
# Kakao Developers > 내 애플리케이션 > 앱 키 > REST API 키
KAKAO_REST_API_KEY=your-kakao-rest-api-key
